{
  "manifest_version": 3,
  "name": "VPS Dashboard — Multi-Panel Monitor",
  "description": "A lightweight, private sidebar monitor for VPS. Supports SolusVM, VirtFusion, Virtualizor, Proxmox, Hetzner, DigitalOcean, AWS Lightsail & EC2.",
  "version": "1.9.0",
  "default_locale": "en",
  "permissions": ["storage"],
  "host_permissions": ["https://*.amazonaws.com/*", "https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
